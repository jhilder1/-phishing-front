# Variables del entorno (Vite)
# Copie este archivo a .env.local para configurar variables locales.

# Base URL de la API REST (opcional). Deje vacío para utilizar el mismo origen (/api/*)
VITE_API_BASE_URL=

# Habilitar simulación de respuestas de la API en el frontend (true/false)
VITE_API_MOCK=false

# Destino del proxy para desarrollo local
DEV_API_PROXY_TARGET=http://localhost:3001
