# ─────────────────────────────────────────────────────────────
# Variables del frontend (Vite). Copie este archivo a `.env.local`.
# IMPORTANTE: todo lo que empiece por VITE_ queda visible en el navegador.
# NUNCA ponga aquí la URL ni la clave de n8n (§3.2, AC-API-03).
# ─────────────────────────────────────────────────────────────

# Base de la API.
# - Vacío (recomendado): el front llama a `/api/*` en el mismo origen. En la nube,
#   el hosting reescribe `/api/**` hacia el backend (cumple §3.1, sin CORS).
# - URL absoluta (p. ej. https://api.midominio.com): solo si el backend habilita CORS.
VITE_API_BASE_URL=

# `true` usa la API simulada del navegador (sin backend), útil mientras n8n no esté listo (S1).
VITE_API_MOCK=false

# Solo desarrollo: destino del proxy de Vite para `/api` (§2.2).
DEV_API_PROXY_TARGET=http://localhost:3001
